{
  "name": "lockin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "design:check": "bash scripts/design-check.sh",
    "inngest": "npx inngest-cli@latest dev",
    "db:up": "docker run -d --name lockin-pg -e POSTGRES_PASSWORD=lockin -e POSTGRES_USER=lockin -e POSTGRES_DB=lockin -p 54322:5432 pgvector/pgvector:pg16 || docker start lockin-pg",
    "db:down": "docker stop lockin-pg",
    "db:reset": "npm run db:down; docker rm -f lockin-pg; npm run db:up && sleep 4 && npm run db:migrate && npm run db:seed",
    "e2e:ui": "playwright test --ui",
    "check": "npm run typecheck && npm run design:check && npm test",
    "auth:smoke": "node scripts/auth-smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.90.2",
    "@tiptap/extension-link": "^3.6.5",
    "@tiptap/extension-mention": "^3.6.5",
    "@tiptap/extension-placeholder": "^3.6.5",
    "@tiptap/extension-task-item": "^3.6.5",
    "@tiptap/extension-task-list": "^3.6.5",
    "@tiptap/pm": "^3.6.5",
    "@tiptap/react": "^3.6.5",
    "@tiptap/starter-kit": "^3.6.5",
    "@tiptap/suggestion": "^3.6.5",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.6",
    "googleapis": "^161.0.0",
    "inngest": "^3.44.1",
    "lucide-react": "^0.545.0",
    "next": "^15.5.4",
    "openai": "^6.2.0",
    "plaid": "^38.1.0",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "resend": "^6.1.2",
    "tailwind-merge": "^3.3.1",
    "twilio": "^5.10.2",
    "web-push": "^3.6.7",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.6.2",
    "@types/react": "^19.1.17",
    "@types/react-dom": "^19.1.11",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.5",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
