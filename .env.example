# ──────────────────────────────────────────────────────────────────────────────
# LIFE OS — environment
# Copy to .env.local and fill in. Only the first block is required to boot.
# SETUP.md explains where each value comes from, click by click.
# ──────────────────────────────────────────────────────────────────────────────

# ── Local development only ───────────────────────────────────────────────────
# A sign-in bypass so the app is usable against a local Postgres before any auth
# provider exists. Ignored entirely when NODE_ENV is production.
LOCKIN_DEV_USER=

# ── Required: database + auth (Supabase) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ── Intelligence ─────────────────────────────────────────────────────────────
# Without ANTHROPIC_API_KEY the app still runs: capture stores raw text, the
# debrief matches on keywords, and Today ranks on deadlines and status.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Embeddings (semantic matching, duplicate detection) and Whisper (voice).
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ── Money ────────────────────────────────────────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ── Calendar and mail ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Messaging ────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=
EMAIL_FROM="LockIn <onboarding@resend.dev>"

# ── Web Push (npx web-push generate-vapid-keys) ──────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Background jobs ──────────────────────────────────────────────────────────
# Without these, jobs run inline and the /api/cron/* routes cover the schedule.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
CRON_SECRET=

# ── Crypto ───────────────────────────────────────────────────────────────────
# Integration tokens are encrypted at rest with this, separate from DATABASE_URL.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
