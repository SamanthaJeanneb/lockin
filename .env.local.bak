# Local development against the Docker Postgres started by `npm run db:up`.
# Swap DATABASE_URL for your Supabase pooler string when you move to the cloud.
DATABASE_URL=postgresql://lockin:lockin@localhost:54322/lockin

# Dev-only sign-in bypass. Works only when NODE_ENV !== 'production'.
# Remove it (and set the Supabase keys) to use real authentication.
LOCKIN_DEV_USER=sam@example.com

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
CRON_SECRET=

ENCRYPTION_KEY=dev-only-change-me-in-production-000000000000
NEXT_PUBLIC_APP_URL=http://localhost:3000
